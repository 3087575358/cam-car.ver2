%% bmp_uri：BMP 抓拍时序
%%{init:{"theme":"base","themeVariables":{"fontFamily":"Microsoft YaHei, Noto Sans SC, sans-serif","fontSize":"20px","actorBkg":"#FFF7D6","actorBorder":"#D97706","signalColor":"#334155","signalTextColor":"#172033","noteBkgColor":"#DBEAFE","noteBorderColor":"#2563EB"}}}%%
sequenceDiagram
  box rgba(250,204,21,0.18) 个人设备端
    actor User as 用户
    participant JS as 前端 JavaScript
    participant View as 图片元素
  end
  box rgba(34,197,94,0.14) ESP32-S3 设备端
    participant HTTP as HTTP Server
    participant Handler as bmp_handler()
    participant Camera as esp32-camera
    participant Conv as BMP 转换器
  end
  Note over HTTP,Handler: 已注册 GET /bmp
  User->>JS: 请求 BMP
  JS->>HTTP: GET /bmp
  Note over JS,HTTP: 无线 Wi-Fi 请求
  HTTP->>Handler: bmp_handler(req)
  Handler->>Camera: esp_camera_fb_get()
  Camera-->>Handler: framebuffer 或 NULL
  alt 抓帧失败
    Handler->>HTTP: HTTP 500
    HTTP-->>JS: ESP_FAIL
  else 抓帧成功
    Handler->>HTTP: 设置 BMP 响应头与时间戳
    Handler->>Conv: frame2bmp(fb)
    Handler->>Camera: esp_camera_fb_return(fb)
    alt 转换失败
      Handler->>HTTP: HTTP 500
      HTTP-->>JS: ESP_FAIL
    else 转换成功
      Conv-->>Handler: buf + buf_len
      Handler->>HTTP: 发送 BMP 数据
      Handler->>Handler: free(buf) 并记录耗时
      HTTP-->>JS: capture.bmp
      Note over HTTP,JS: 无线 Wi-Fi 返回
      JS->>View: 更新图片
      View-->>User: 显示 BMP
    end
  end

