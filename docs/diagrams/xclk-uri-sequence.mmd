%% xclk_uri：XCLK 设置时序
%%{init:{"theme":"base","themeVariables":{"fontFamily":"Microsoft YaHei, Noto Sans SC, sans-serif","fontSize":"20px","actorBkg":"#FFF7D6","actorBorder":"#D97706","signalColor":"#334155","signalTextColor":"#172033","noteBkgColor":"#DBEAFE","noteBorderColor":"#2563EB"}}}%%
sequenceDiagram
  box rgba(250,204,21,0.18) 个人设备端
    actor User as 用户
    participant JS as 前端 JavaScript
  end
  box rgba(34,197,94,0.14) ESP32-S3 设备端
    participant HTTP as HTTP Server
    participant Handler as xclk_handler()
    participant Sensor as sensor_t
    participant LEDC as ESP32-S3 LEDC
    participant Pin as OV2640 XCLK 引脚
  end
  Note over HTTP,Handler: 已注册 GET /xclk
  User->>JS: 输入 MHz 并确认
  JS->>HTTP: GET /xclk?xclk=数值
  Note over JS,HTTP: 无线 Wi-Fi 请求
  HTTP->>Handler: xclk_handler(req)
  Handler->>Handler: parse_get() + 读取 xclk
  alt 参数缺失或解析失败
    Handler-->>HTTP: ESP_FAIL 或 HTTP 404
    HTTP-->>JS: 错误
  else 参数有效
    Handler->>Sensor: set_xclk(LEDC_TIMER_0, xclk)
    Sensor->>LEDC: 配置 xclk × 1,000,000 Hz
    LEDC->>Pin: 输出新 XCLK 方波
    alt 驱动失败
      Handler->>HTTP: HTTP 500
      HTTP-->>JS: 错误
    else 驱动成功
      Handler->>HTTP: CORS + HTTP 200
      Note over Handler,JS: 无线 Wi-Fi 返回
      HTTP-->>JS: 空响应
    end
  end

