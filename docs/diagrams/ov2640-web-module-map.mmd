flowchart LR
    user(["用户：点击或触屏"])

    subgraph phone["手机 / 电脑浏览器"]
        html["HTML 控件\n显示输入与按钮"]
        js["JavaScript 事件函数\n读取数值并构造请求"]
        view["img 元素\n显示照片或视频流"]
    end

    subgraph esp[ESP32开发板]
        subgraph esp-web["ESP32-S3 Web Server"]
            router{"URI 路由"}
            control["控制处理函数\n修改相机参数"]
            capture["capture_handler\n抓取单张 JPEG"]
            stream["stream_handler\n持续发送 JPEG 帧"]
        end

        subgraph esp-hardware["ESP32-S3 Hardware"]
            camera["esp32-camera 驱动"]
            sensor["OV2640 传感器"]
        end
    end

    user --> html --> js -->|"HTTP GET"| router
    router -->|"/control、/xclk 等"| control --> camera
    router -->|"/capture"| capture --> camera
    router -->|"端口 81：/stream"| stream --> camera
    camera <--> sensor
    capture -->|"JPEG"| view
    stream -->|"MJPEG"| view

